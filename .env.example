# Runtime data location.
# Dynamic data such as sessions, traces, artifacts, and local secrets live here.
SAFEPLANE_HOME=~/.safeplane

# Model gateway mode.
#
# fake:
#   Used by normal tests and local development by default.
#   Does not create model cost.
#   Does not call OpenRouter.
#
# real:
#   Manual smoke test mode only.
#   Uses docker-compose.real.yml.
#   Requires the OpenRouter secret file:
#
#     ${SAFEPLANE_HOME}/secrets/openrouter_api_key
#
# Create it with:
#
#     make secret-set-openrouter
MODEL_GATEWAY_MODE=fake
