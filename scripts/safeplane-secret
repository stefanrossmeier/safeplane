#!/usr/bin/env python3
from __future__ import annotations

import argparse
import getpass
import os
from pathlib import Path
import subprocess
import tempfile


SECRET_FILE_ENV = {
    "openrouter_api_key": "SAFEPLANE_OPENROUTER_API_KEY_FILE",
    "github_token": "SAFEPLANE_GITHUB_TOKEN_FILE",
    "telegram_bot_token": "SAFEPLANE_TELEGRAM_BOT_TOKEN_FILE",
    "telegram_allowed_user_ids": "SAFEPLANE_TELEGRAM_ALLOWED_USER_IDS_FILE",
}


def secret_root() -> Path:
    path = Path(
        os.environ.get(
            "SAFEPLANE_SECRET_ROOT",
            str(Path.home() / ".config" / "safeplane" / "secrets"),
        )
    ).expanduser()
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o700)
    return path


def secret_path(name: str) -> Path:
    configured_name = SECRET_FILE_ENV.get(name)
    configured = os.environ.get(configured_name) if configured_name else None
    path = Path(configured).expanduser() if configured else secret_root() / name
    path.parent.mkdir(parents=True, exist_ok=True)
    path.parent.chmod(0o700)
    return path


def set_secret(name: str) -> None:
    value = getpass.getpass(f"Enter value for secret {name!r}: ")
    if not value:
        raise SystemExit("Refusing to write empty secret.")

    path = secret_path(name)
    payload = value.strip() + "\n"
    target_uid = os.environ.get("SAFEPLANE_SECRET_UID")
    target_gid = os.environ.get("SAFEPLANE_SECRET_GID", target_uid or "")
    if target_uid:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", delete=False) as handle:
            temporary = Path(handle.name)
            handle.write(payload)
        temporary.chmod(0o600)
        try:
            subprocess.run(
                [
                    "sudo",
                    "install",
                    "-o",
                    target_uid,
                    "-g",
                    target_gid,
                    "-m",
                    "0600",
                    str(temporary),
                    str(path),
                ],
                check=True,
            )
        finally:
            temporary.unlink(missing_ok=True)
    else:
        temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}")
        temporary.write_text(payload, encoding="utf-8")
        temporary.chmod(0o600)
        temporary.replace(path)
    print(f"Secret written to {path}")


def list_secrets() -> None:
    root = secret_root()
    print(f"Secret root: {root}")
    files = [path for path in sorted(root.glob("*")) if path.is_file()]
    if files:
        for path in files:
            print(f"- {path.name}")
    else:
        print("(no secret files)")

    configured_paths = {
        name: secret_path(name)
        for name in sorted(SECRET_FILE_ENV)
        if os.environ.get(SECRET_FILE_ENV[name])
    }
    if configured_paths:
        print("Configured per-secret paths:")
        for name, path in configured_paths.items():
            print(f"- {name}: {path} ({'present' if path.is_file() else 'missing'})")


def main() -> None:
    parser = argparse.ArgumentParser(description="Manage Safeplane local secrets.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    set_parser = subparsers.add_parser("set")
    set_parser.add_argument("name")
    subparsers.add_parser("list")

    args = parser.parse_args()
    if args.command == "set":
        set_secret(args.name)
    elif args.command == "list":
        list_secrets()


if __name__ == "__main__":
    main()
