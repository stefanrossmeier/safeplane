# Required for live Jev evaluation through OpenRouter.
OPENROUTER_API_KEY=

# Pin a concrete Jev model for reproducible recorded runs.
ROUTING_ADVISOR_JEV_MODEL=typesafe/jev-1.13

# Optional transport settings.
ROUTING_ADVISOR_OPENROUTER_URL=https://openrouter.ai/api/alpha/decisions
ROUTING_ADVISOR_CONCURRENCY=8
ROUTING_ADVISOR_TIMEOUT_SECONDS=30
ROUTING_ADVISOR_MAX_RETRIES=3
