# Safeplane VPS operator environment for Ubuntu 24.04 amd64.
SAFEPLANE_HOME=/var/lib/safeplane
SAFEPLANE_SECRET_ROOT=/etc/safeplane/secrets
SAFEPLANE_BACKUP_ROOT=/var/backups/safeplane
SAFEPLANE_LOG_ROOT=/var/log/safeplane
SAFEPLANE_OPERATOR_USER=agenter
SAFEPLANE_VPS_PROFILE=assistant
SAFEPLANE_LOG_MAX_SIZE=10m
SAFEPLANE_LOG_MAX_FILES=5
SAFEPLANE_SECRET_UID=10001
SAFEPLANE_SECRET_GID=10001
SAFEPLANE_MODEL_PROFILE_DEVELOPER_DOCUMENTATION=openrouter/openai/gpt-5-mini
SAFEPLANE_MODEL_PROFILE_DEVELOPER_ANALYSIS=openrouter/anthropic/claude-haiku-4.5
SAFEPLANE_MODEL_PROFILE_DEVELOPER_PLANNING=openrouter/anthropic/claude-sonnet-4.6
SAFEPLANE_MODEL_PROFILE_DEVELOPER_IMPLEMENTATION=openrouter/openai/gpt-5-mini
SAFEPLANE_MODEL_PROFILE_DEVELOPER_REVIEW=openrouter/anthropic/claude-haiku-4.5
SAFEPLANE_MODEL_PROFILE_DEVELOPER_PR=openrouter/openai/gpt-5.4-nano
